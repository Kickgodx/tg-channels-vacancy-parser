# Полный стек (app + Prometheus/Grafana/Loki/Alloy/Tempo). Compose читает .env сам.
# Лёгкий режим: закомментируйте или COMPOSE_PROFILES=
COMPOSE_PROFILES=observability

# Опционально: прокси для HTTP-запросов к t.me (формат httpx)
# HTTP_PROXY=http://149.154.167.40:443
# HTTPS_PROXY=http://149.154.167.40:443

# --- Telethon (основной способ чтения каналов) ---
# Создайте приложение на https://my.telegram.org/apps
# Никому не отправляйте api_hash и не коммитьте .env и sessions/.
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_api_hash_here
# Номер при первой авторизации (как в Telegram, с + и кодом страны). Уменьшает ручной ввод в консоли:
TELEGRAM_PHONE=+79161234567
# Только для локальной машины — пароль облака Telegram (2FA), если включён:
# TELEGRAM_2FA_PASSWORD=

# --- OpenRouter (опционально, ai.enabled в config.yaml) ---
# https://openrouter.ai/keys
OPENROUTER_API_KEY=
# OPENROUTER_HTTP_REFERER=https://github.com/your/repo
# OPENROUTER_APP_TITLE=tg-jobs-parser
# OPENROUTER_API_KEY=

# --- Режим окружения ---
# dev (по умолчанию) — локальная разработка: регистрация открыта, тела HTTP пишутся
# в лог, JWT_SECRET необязателен. prod — регистрация закрыта после первого
# пользователя, тела в лог не пишутся, без JWT_SECRET (32+ символа) backend и
# воркеры не стартуют. Явно заданные AUTH_REGISTRATION_OPEN / HTTP_LOG_BODIES
# побеждают в обоих режимах.
# APP_ENV=dev
# Адрес публикации портов docker compose. По умолчанию 127.0.0.1 — стек доступен
# только с этой машины. 0.0.0.0 — открыть в сеть:
# BIND_ADDR=127.0.0.1         # UI :5173 и API :9000
# INFRA_BIND_ADDR=127.0.0.1   # Postgres, Redis, Prometheus/Grafana/Loki/Alloy/Tempo

# --- Backend API (Docker / локально) ---
# Postgres и Redis с хоста — по 127.0.0.1, не localhost: порты опубликованы только на
# IPv4-loopback, а localhost сначала пробует ::1 (на Windows — ожидание до connect timeout).
# DATABASE_URL=postgresql+psycopg://tgjobs:tgjobs@127.0.0.1:5432/tgjobs
# API_HOST=0.0.0.0
# API_PORT=8000
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Дополнительный X-API-Key поверх JWT (не замена логину):
# API_KEY=
# Подпись access-токенов. В dev без него — эфемерный секрет (сессии сгорают при
# рестарте); в prod обязателен. Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(48))"
# JWT_SECRET=
# JWT_TTL_MINUTES=60
# Умолчание зависит от APP_ENV (dev — true, prod — false):
# AUTH_REGISTRATION_OPEN=true
# HTTP_LOG_BODIES=true
# Для frontend (Vite) при заданном API_KEY — тот же ключ в query SSE / X-API-Key на export:
# VITE_API_KEY=

# --- LLM jobs (Redis Queue). В Docker Compose по умолчанию rq + redis ---
# LLM_JOB_BACKEND=inprocess   # ThreadPool в API (локальные тесты / без Redis)
# LLM_JOB_BACKEND=rq
# REDIS_URL=redis://127.0.0.1:16379/0
# LLM_WORKER_METRICS_PORT=9101   # контейнерный порт; в compose не публикуется на хост (scale)
# LLM_JOB_STUCK_MINUTES=15
# LLM_JOB_LEASE_SECONDS=120      # heartbeat lease running LLM-джобы
# LLM_RQ_JOB_TIMEOUT_SECONDS=600
# JOB_RECOVER_INTERVAL_SECONDS=60  # периодический recover (помимо on-start): в worker, при inprocess — в API
# ANALYTICS_CACHE_SECONDS=30     # кэш агрегатов дашборда/аналитики в памяти API (сек); 0 — выключить
# LLM_JOB_MAX_ATTEMPTS=2         # после стольких попыток зависшая джоба → error вместо requeue

# --- Parse jobs (Redis Queue). В Docker Compose: rq + parse-worker ---
# PARSE_JOB_BACKEND=inprocess   # ThreadPool в API (локально без Redis)
# PARSE_JOB_BACKEND=rq
# PARSE_JOB_STUCK_MINUTES=30         # stale queued без живого RQ job
# PARSE_JOB_LEASE_SECONDS=120        # heartbeat lease running parse
# PARSE_JOB_MAX_ATTEMPTS=3           # после стольких попыток зависший прогон → failed вместо requeue
# PARSE_RQ_JOB_TIMEOUT_SECONDS=43200  # 12 ч; длинные прогоны Telethon
# PARSE_WORKER_METRICS_PORT=9102      # контейнерный порт; в compose не на хост

# --- HH.ru (admin sync; токен получаете вручную, например через dev.hh.ru) ---
# HH_API_TOKEN=
# HH_CONTACT_EMAIL=you@example.com
