        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le, job) (rate(llm_rate_gate_wait_seconds_bucket[5m])))",
          "legendFormat": "p50 {{job}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, job) (rate(llm_rate_gate_wait_seconds_bucket[5m])))",
          "legendFormat": "p95 {{job}}",
          "refId": "B"
        }
      ],
      "description": "Входит в latency OpenRouter выше: полный вызов = ожидание слота ai.requests_per_minute + HTTP-запрос."
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "id": 11,
      "title": "Повторы / мин",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 28 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "short",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "stacking": { "mode": "none", "group": "A" },
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "expr": "sum by (reason, model) (rate(llm_retries_total[5m])) * 60",
          "legendFormat": "{{reason}} {{model}}",
          "refId": "A"
        }
      ],
      "description": "rate_limit — 429 от OpenRouter; transient — 5xx / таймаут / обрыв."
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "id": 12,
      "title": "Стоимость, $ / час по модели",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 28 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "currencyUSD",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "stacking": { "mode": "none", "group": "A" },
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "expr": "sum by (model) (rate(llm_cost_usd_total[5m])) * 3600",
          "legendFormat": "{{model}}",
          "refId": "A"
        }
      ],
      "description": "Оценка по ценам llm_models.yaml; модели без цены не учитываются."
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "id": 13,
      "title": "Стоимость LLM за 24 ч",
      "type": "stat",
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 36 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
