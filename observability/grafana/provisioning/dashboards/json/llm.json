        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        { "expr": "sum(increase(llm_cost_usd_total[24h])) or vector(0)", "refId": "A", "instant": true }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "id": 14,
      "title": "Стоимость LLM за 1 ч",
      "type": "stat",
      "gridPos": { "h": 4, "w": 8, "x": 8, "y": 36 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "unit": "currencyUSD",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }] },
          "decimals": 3
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        { "expr": "sum(increase(llm_cost_usd_total[1h])) or vector(0)", "refId": "A", "instant": true }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "id": 15,
      "title": "Повторов LLM за 1 ч",
      "type": "stat",
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 36 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }] },
