// Grafana Alloy — единый коллектор:
// 1) логи: stdout/stderr контейнеров этого compose-проекта → Loki.
//    discovery.docker → relabel (labels service/container/stream)
//    → loki.source.docker → loki.process (level/logger, request_id/trace_id)
//    → loki.write.
// 2) трассы: OTLP от backend и воркеров (http :4318 / grpc :4317) → filter
//    (шумные span'ы) → batch → Tempo.

// Docker API — через docker-socket-proxy (только чтение контейнеров/сетей/логов),
// сам docker.sock в Alloy не монтируется.

logging {
	level  = "info"
	format = "logfmt"
}

discovery.docker "containers" {
	host = "tcp://docker-socket-proxy:2375"
}

discovery.relabel "compose" {
	targets = discovery.docker.containers.targets

	// Только контейнеры этого compose-проекта (имя — от каталога репозитория).
	rule {
		source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
		regex         = "tg.?jobs.?parser"
		action        = "keep"
	}

	rule {
		source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
		target_label  = "service"
	}

	rule {
		source_labels = ["__meta_docker_container_name"]
		regex         = "/(.*)"
		target_label  = "container"
	}
}

loki.source.docker "containers" {
	host       = "tcp://docker-socket-proxy:2375"
	targets    = discovery.relabel.compose.output
	forward_to = [loki.process.app.receiver]
}

loki.process "app" {
	// Формат backend (tg_jobs_parser/utils/logger.py):
	// "2026-09-20 10:00:00 | INFO | backend.main | сообщение"
	// с контекстом: "... | backend.http | request_id=<uuid> trace_id=<32 hex> | сообщение"
	// (каждая часть контекста необязательна).
	stage.regex {
		expression = `^\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2} \| (?P<level>[A-Z]+) \| (?P<logger>[^|]+?) \| (?:request_id=(?P<request_id>[0-9a-f-]{36}) ?)?(?:trace_id=(?P<trace_id>[0-9a-f]{32}) )?`
	}

	stage.labels {
		values = {
			level  = "",
			logger = "",
		}
	}

	// request_id/trace_id уникальны — не labels (кардинальность), а structured
	// metadata: фильтр в LogQL `| request_id="<uuid>"` / `| trace_id="<hex>"`.
	stage.structured_metadata {
		values = {
			request_id = "",
			trace_id   = "",
		}
	}

	forward_to = [loki.write.local.receiver]
}

loki.write "local" {
	endpoint {
		url = "http://loki:3100/loki/api/v1/push"
	}
}

otelcol.receiver.otlp "default" {
	http {
		endpoint = "0.0.0.0:4318"
	}

	grpc {
		endpoint = "0.0.0.0:4317"
	}

	output {
		traces = [otelcol.processor.filter.noise.input]
	}
}

// SQLAlchemy-инструментация пишет span "connect" на каждую выдачу соединения из
// пула: ~2 мс, без детей, ~1700 штук на прогон с AI (четверть трассы). Сам SQL
// (SELECT/INSERT/UPDATE) остаётся.
otelcol.processor.filter "noise" {
	error_mode = "ignore"

	traces {
		span = [
			`name == "connect" and attributes["db.system"] != nil`,
		]
	}

	output {
		traces = [otelcol.processor.batch.default.input]
	}
}

otelcol.processor.batch "default" {
	output {
		traces = [otelcol.exporter.otlp.tempo.input]
	}
}

otelcol.exporter.otlp "tempo" {
	client {
		endpoint = "tempo:4317"

		tls {
			insecure = true
		}
	}
}
